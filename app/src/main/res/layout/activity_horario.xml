<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azulino_claro"
    android:orientation="vertical"
    tools:context=".actividades.HorarioActivity">

    <!-- Header con estilo institucional -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHorario"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:elevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORARIO ESCOLAR"
                android:textColor="@color/azul_marino"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <ImageButton
                android:id="@+id/btnBackHorario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/azul_marino" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Selector de Días (Estilo Pestañas Modernas) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="12dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tabLunes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUN"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:background="@drawable/redondeado"
                android:backgroundTint="@color/azul_marino"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tabMartes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAR"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/gris_upn"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tabMiercoles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIE"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/gris_upn"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tabJueves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JUE"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/gris_upn"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tabViernes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIE"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/gris_upn"
                android:textStyle="bold"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/containerClases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Clase 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/time1"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="08:00\nAM"
                    android:textColor="@color/azul_marino"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/time1"
                    android:layout_marginStart="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FAFAFA">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Matemática"
                            android:textColor="@color/azul_marino"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prof. Ricardo Gareca | Aula 302"
                            android:textColor="@color/gris_upn"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Clase 2 (Recreo) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/time2"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="10:30\nAM"
                    android:textColor="@color/gris_upn"
                    android:textSize="14sp"
                    android:gravity="center" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_toEndOf="@id/time2"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true"
                    android:background="#D0D0D0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/time2"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:background="@color/azulino_claro"
                    android:paddingHorizontal="12dp"
                    android:text="RECESO"
                    android:textColor="@color/gris_upn"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Clase 3 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/time3"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="11:00\nAM"
                    android:textColor="@color/azul_marino"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/time3"
                    android:layout_marginStart="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comunicación"
                            android:textColor="@color/azul_marino"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prof. Maria Elena | Aula 105"
                            android:textColor="@color/gris_upn"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
