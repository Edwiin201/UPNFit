<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azulino_claro"
    android:fillViewport="true"
    tools:context=".actividades.MenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Institucional -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnmenuPerfil"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/circulo_verde"
                android:backgroundTint="@color/azul_marino"
                android:text="SP"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/btnmenuPerfil"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portal del Estudiante"
                    android:textColor="@color/gris_upn"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/textoBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sofia Pérez Malpartida"
                    android:textColor="@color/azul_marino"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/configuracion"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/azul_marino" />
        </RelativeLayout>

        <!-- Card de Información del Ciclo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTituloResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen Académico 2024-II"
                    android:textColor="@color/azul_marino"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/dorado_perfil" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Promedio -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/star_on"
                            app:tint="@color/dorado_perfil"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/lblPromedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROMEDIO"
                            android:textSize="10sp"
                            android:textColor="@color/gris_upn" />
                        <TextView
                            android:id="@+id/tvValorPromedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18.5"
                            android:textColor="@color/azul_marino"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center" android:background="#F0F0F0" />

                    <!-- Asistencia -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="@color/azul_marino"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/lblAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ASISTENCIA"
                            android:textSize="10sp"
                            android:textColor="@color/gris_upn" />
                        <TextView
                            android:id="@+id/tvValorAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="95%"
                            android:textColor="@color/azul_marino"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center" android:background="#F0F0F0" />

                    <!-- Cursos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/azul_marino"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/lblCursos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURSOS"
                            android:textSize="10sp"
                            android:textColor="@color/gris_upn" />
                        <TextView
                            android:id="@+id/tvValorCursos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="06"
                            android:textColor="@color/azul_marino"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Servicios Académicos"
            android:textColor="@color/azul_marino"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"/>

        <!-- Grid de Acciones Institucional -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Calificaciones (Apoderado) / Subir Notas (Profesor) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/imgCardNotas"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvCardNotas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notas"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSubCardNotas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver récord académico"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tareas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTareas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/imgCardTareas"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvCardTareas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tareas"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSubCardTareas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actividades pendientes"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mensajes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMensajes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/stat_notify_chat"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvCardMensajes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mensajes"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSubCardMensajes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat con profesores"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Exámenes / Calendario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExamenes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/imgCardExamenes"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvCardExamenes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exámenes"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSubCardExamenes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fechas y resultados"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Horarios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHorarios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horarios"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cursos y aulas"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Asistencia -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAsistenciaMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/imgCardAsistencia"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="@color/azul_marino"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvCardAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asistencia"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSubCardAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control de faltas"
                        android:textSize="10sp"
                        android:textColor="@color/gris_upn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

    </LinearLayout>

</ScrollView>
