<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarillo_upn"
    tools:context=".actividades.MenuActivity">

  <LinearLayout
      android:id="@+id/mainContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="30dp"
      android:orientation="vertical"
      android:padding="15dp">

    <!-- Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#84BF41"
        app:cardCornerRadius="600dp"
        app:cardElevation="4dp">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnAbrirMenu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:background="@android:color/transparent"
            android:src="@drawable/temporizador" />

        <ImageButton
            android:id="@+id/configuracion"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Configuración"
            android:focusable="true"
            android:src="@drawable/ic_settings"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvmeditacion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="Bienvenido a UPNFIT"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
      </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bienvenida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:layout_marginTop="12dp"
        android:background="#EAF6E5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/textoBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Buen día, Carlos!"
            android:textColor="#2E7D32"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtObjetivosMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tus objetivos:"
            android:textColor="@color/black"
            android:textSize="17sp" />
      </LinearLayout>

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btnmenuPerfil"
          android:layout_width="60dp"
          android:layout_height="60dp"
          android:background="@drawable/circulo_verde"
          android:text="CP"
          android:textAllCaps="false"
          android:textColor="@color/white"
          android:textSize="30dp" />
    </LinearLayout>

    <!-- Resumen Diario -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Resumen Diario"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/redondeado"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

      <TextView
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:layout_marginLeft="20dp"
          android:layout_marginTop="10dp"
          android:layout_marginRight="50dp"
          android:background="@drawable/circulo_verde"
          android:gravity="center"
          android:padding="16dp"
          android:text="1200\nCal"
          android:textColor="@color/black"
          android:textSize="14sp" />

      <TextView
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:layout_marginTop="10dp"
          android:layout_marginRight="50dp"
          android:background="@drawable/circulo_azul"
          android:gravity="center"
          android:padding="16dp"
          android:text="6/8\nPasos"
          android:textColor="@color/black"
          android:textSize="14sp" />

      <TextView
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/circulo_morado"
          android:gravity="center"
          android:padding="16dp"
          android:text="45/60\nmin"
          android:textColor="@color/black"
          android:textSize="14sp" />
    </LinearLayout>

    <!-- Consejo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Consejo Diario"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvConsejoDia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/fondo_consejo"
        android:elevation="2dp"
        android:padding="10dp"
        android:text="Cargando consejo del día..."
        android:textAlignment="center"
        android:textColor="#4CAF50"
        android:textSize="19sp" />

    <!-- Acciones rápidas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

      <TextView
          android:id="@+id/tvTitulo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Acciones rápidas"
          android:textColor="@color/black"
          android:textSize="20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardAnimo"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_margin="8dp"
          app:cardCornerRadius="12dp"
          app:layout_constraintEnd_toStartOf="@id/cardComida"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/tvTitulo"
          app:layout_constraintWidth_percent="0.48"
          app:strokeColor="@color/white"
          app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="15dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Estado de Ánimo"
              android:textColor="@color/black"
              android:textStyle="bold" />

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😐 "
                android:textSize="24sp" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circulo_negro" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circulo_negro" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardComida"
          android:layout_width="165dp"
          android:layout_height="90dp"
          android:layout_margin="1dp"
          app:cardCornerRadius="12dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@id/cardAnimo"
          app:layout_constraintTop_toTopOf="@id/cardAnimo"
          app:layout_constraintWidth_percent="0.48"
          app:strokeColor="#e67e22"
          app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="158dp"
            android:layout_height="125dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Próxima Comida"
              android:textColor="@color/black"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Almuerzo: 12:30"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Ensalada de pollo"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="450 calorías"
              android:textColor="@color/black" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardActividad"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_margin="8dp"
          app:cardCornerRadius="12dp"
          app:layout_constraintEnd_toStartOf="@id/cardMind"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/cardAnimo"
          app:layout_constraintWidth_percent="0.48"
          app:strokeColor="#d291bc"
          app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="12dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Actividad Física"
              android:textColor="@color/black"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Yoga - 18:00"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="15 minutos"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Iniciar ahora"
              android:textColor="@color/black"
              android:textStyle="bold" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardMind"
          android:layout_width="165dp"
          android:layout_height="100dp"
          android:layout_margin="1dp"
          app:cardCornerRadius="12dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@id/cardActividad"
          app:layout_constraintTop_toTopOf="@id/cardActividad"
          app:layout_constraintWidth_percent="0.48"
          app:strokeColor="#2ecc71"
          app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="12dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Mindfulness"
              android:textColor="@color/black"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Respiración guiada"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="5 minutos"
              android:textColor="@color/black" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Comenzar"
              android:textColor="@color/black"
              android:textStyle="bold" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

  </LinearLayout>

</ScrollView>
