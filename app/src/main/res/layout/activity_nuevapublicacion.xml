<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarillo_upn"
    android:padding="16dp">

    <!-- Barra superior (Fija) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#2781C6"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/regresomenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Cerrar"
                android:focusable="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Nueva Publicación"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- ScrollView para hacer el formulario responsive -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Contenedor principal del formulario -->
            <androidx.cardview.widget.CardView
                android:id="@+id/publicacionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/fondo_tarjeta_publicacion"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/nuevapublia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Encabezado usuario -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <!-- Avatar circular -->
                        <TextView
                            android:id="@+id/avatarIniciales"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:drawable/btn_default"
                            android:backgroundTint="#BBDEFB"
                            android:elevation="2dp"
                            android:gravity="center"
                            android:text="UP"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Nombre + estado -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textViewNombrePublicacion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Nombre Usuario"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Compartiendo con la comunidad"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- TÍTULO -->
                    <EditText
                        android:id="@+id/editTextTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/redondeado"
                        android:hint="Título de la publicación"
                        android:padding="12dp"
                        android:textColorHint="@color/gris_upn"
                        android:textSize="16sp" />

                    <!-- SELECTOR DE CATEGORÍA -->
                    <Spinner
                        android:id="@+id/spinnerCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/redondeado"
                        android:entries="@array/categorias_publicacion"
                        android:minHeight="48dp"
                        android:padding="10dp" />

                    <!-- Caja de texto contenido -->
                    <EditText
                        android:id="@+id/editTextPublicacion"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/redondeado"
                        android:gravity="top|start"
                        android:hint="¿Qué quieres compartir con la comunidad?"
                        android:padding="12dp"
                        android:textColorHint="@color/gris_upn"
                        android:textSize="14sp" />

                    <!-- Botón Publicar -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPublicar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:background="@drawable/redondeado"
                        android:backgroundTint="#2781C6"
                        android:elevation="4dp"
                        android:paddingLeft="32dp"
                        android:paddingTop="12dp"
                        android:paddingRight="32dp"
                        android:paddingBottom="12dp"
                        android:text="Publicar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
